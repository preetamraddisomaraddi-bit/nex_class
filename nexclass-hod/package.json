{
  "name": "nexclass-hod",
  "version": "1.0.0",
  "description": "NexClass HOD Portal",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 5176\" \"wait-on http://localhost:5176 && electron .\"",
    "build": "vite build",
    "package": "vite build && electron-builder",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "package:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "electron-store": "^8.1.0",
    "jspdf": "^2.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.nexclass.hod",
    "productName": "NexClass HOD Portal",
    "copyright": "Copyright © 2025 NexClass",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NexClass-HOD-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "NexClass-HOD-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "NexClass-HOD-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NexClass HOD"
    }
  }
}
