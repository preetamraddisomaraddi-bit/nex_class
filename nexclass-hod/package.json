{
  "name": "nexclass-hod",
  "version": "1.0.0",
  "description": "NexClass HOD Portal",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite --port 5175\" \"wait-on http://localhost:5175 && electron .\"",
    "build": "vite build",
    "test:server": "cross-env ELECTRON_RUN_AS_NODE=1 electron node_modules/jest/bin/jest.js --runInBand --roots server/tests",
    "server:headless": "cross-env ELECTRON_RUN_AS_NODE=1 electron server/cli.js",
    "postinstall": "npm install --prefix server --omit=dev --ignore-scripts && electron-rebuild -f -w better-sqlite3 --module-dir=server",
    "package": "vite build && electron-builder",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "package:mac": "npm run build && electron-builder --mac dmg",
    "package:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "electron-store": "^8.1.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^2.5.1",
    "pino": "^8.21.0",
    "pino-http": "^9.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.21.0",
    "socket.io": "^4.6.1",
    "socket.io-client": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "jest": "^29.7.0",
    "postcss": "^8.4.32",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.nexclass.hod",
    "productName": "NexClass HOD Portal",
    "copyright": "Copyright © 2025 NexClass",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "server/node_modules/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server/node_modules",
        "to": "server-node-modules",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "server/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "NexClass-HOD-Setup-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "NexClass-HOD-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "NexClass-HOD-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NexClass HOD"
    }
  }
}
